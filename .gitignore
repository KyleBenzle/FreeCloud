# Python runtime files
__pycache__/
*.py[cod]

# FreeCloud local runtime files from early development builds
.freecloud_*.json
.freecloud_*.log
.freecloud_*.pid

# Android/Gradle build output
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties

# Local signing credentials should not be committed.
*.jks
*.keystore
