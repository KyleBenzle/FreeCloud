<component type="desktop-application">
  <id>io.github.kylebenzle.freecloud</id>
  <metadata_license>GPL-3.0-or-later</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FreeCloud</name>
  <summary>Use your existing web hosting as a personal cloud drive</summary>
  <description>
    <p>
      FreeCloud connects a local folder to storage on a PHP-enabled web host
      that you control. It provides an Explorer-style cloud file browser,
      background synchronization, and access to the same files through a web
      interface.
    </p>
    <p>
      Users upload the included server files to their own hosting account and
      configure the desktop client with that website address.
    </p>
  </description>
  <launchable type="desktop-id">freecloud.desktop</launchable>
  <icon type="stock">freecloud</icon>
  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
  </categories>
