<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FreeCloud" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/freecloud_blue</item>
        <item name="colorPrimaryVariant">@color/freecloud_blue_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/freecloud_blue</item>
        <item name="android:statusBarColor">@color/freecloud_bg</item>
        <item name="android:windowBackground">@color/freecloud_bg</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="android:textColor">@color/freecloud_ink</item>
        <item name="android:navigationBarColor">@color/freecloud_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.FreeCloud.Medium</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FreeCloud.Large</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.FreeCloud.Large</item>
    </style>

    <style name="ShapeAppearance.FreeCloud.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.FreeCloud.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
