<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/freecloud_subtle_panel_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/fileGlyphText"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="📄"
        android:textColor="@color/freecloud_blue_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fileNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/freecloud_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filePathText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/freecloud_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/fileStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/freecloud_synced_badge_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="Synced"
        android:textColor="@color/freecloud_success"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
